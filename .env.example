# Connect to Course - Local Environment Configuration
# Copy this file to .env and fill in your values

# Database Connection (Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Flask Session Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Optional: RapidAPI Scraper Credentials (only needed if running fetch_api_db.py)
API_KEY=your_rapidapi_key
API_HOST=udemy-course-scrapper-api.p.rapidapi.com
